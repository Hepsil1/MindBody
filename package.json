{
  "name": "mindbody",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npx prisma generate && react-router build",
    "dev": "react-router dev --port 3000",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write \"**/*.{ts,tsx,js,cjs,mjs,json,jsonc,md,mdx,css,yml,yaml,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,cjs,mjs,json,jsonc,md,mdx,css,yml,yaml,prisma}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-router/node": "7.12.0",
    "@react-router/serve": "7.12.0",
    "@unpic/react": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "isbot": "^5.1.31",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "plaiceholder": "^3.0.0",
    "prisma": "^5.22.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "7.12.0",
    "resend": "^6.12.3",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@react-router/dev": "7.12.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.6.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.3",
    "prettier-plugin-prisma": "5.0.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.59.3",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
