.DS_Store
.env
/node_modules/

# React Router
/.react-router/
/build/

# Logs (Caddy, build, vite, typescript)
*.log
logs/
caddy_access.log
build_output.txt

# Local tooling
# NOTE: .claude/skills/ are project-scoped skills committed to the repo.
# Only personal/session data is ignored.
/.claude/sessions/
/.claude/cache/
/.claude/logs/
/.claude/projects/
/tmp/
/tmp_repos/
/.tmp_repos/
backups/

# Vitest coverage output
coverage/

# Playwright E2E artifacts (traces, screenshots, reports)
test-results/
playwright-report/
playwright/.cache/

# Responsive image variants — regenerated by `npm run build:images`
# on every deploy.  Master files (no -NNNw suffix) ARE tracked; the
# scaled width-variants are not.
public/**/*-[0-9][0-9][0-9]w.webp
public/**/*-[0-9][0-9][0-9][0-9]w.webp
graphify-out/

# Ad-hoc audit / walkthrough artifacts (prior agent screenshots & snapshots) — not source
/*.png
/*.jpeg
/*.jpg
/*.gif
.playwright-mcp/
/temp-app.css
/UsersAdministratorAppDataLocalTemplive-app.css
