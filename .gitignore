.DS_Store
.env
# Any env variant (e.g. .env.bak, .env.local) — but keep the committed template.
.env.*
!.env.example
# Stray backup files must never be committed (they often carry secrets/config).
*.bak
*.bak.*
/node_modules/

# React Router
/.react-router/
/build/

# Logs (Caddy, build, vite, typescript)
*.log
logs/
caddy_access.log
build_output.txt

# Local tooling
# NOTE: .claude/skills/ are project-scoped skills committed to the repo.
# Only personal/session data is ignored.
/.claude/sessions/
/.claude/cache/
/.claude/logs/
/.claude/projects/
/tmp/
/tmp_repos/
/.tmp_repos/
backups/

# Vitest coverage output
coverage/

# Playwright E2E artifacts (traces, screenshots, reports)
test-results/
playwright-report/
playwright/.cache/

# Responsive image variants — regenerated by `npm run build:images`
# on every deploy.  Master files (no -NNNw suffix) ARE tracked; the
# scaled width-variants are not.
public/**/*-[0-9][0-9][0-9]w.webp
public/**/*-[0-9][0-9][0-9][0-9]w.webp
graphify-out/

# Instagram scrape — runtime data, regenerated hourly by the background refresh
# (downloaded masters + .webp/.avif variants + ig-cache.json). All reproducible;
# the -NNNw globs above only cover .webp, so this blanket rule catches .avif + JSON.
public/instagram/*
!public/instagram/.gitkeep

# Ad-hoc audit / walkthrough artifacts (prior agent screenshots & snapshots) — not source
/*.png
/*.jpeg
/*.jpg
/*.gif
.playwright-mcp/
/temp-app.css
/UsersAdministratorAppDataLocalTemplive-app.css
public/uploads/_video_originals/

# Raw Telegram brand-content exports (not committed)
tg-content/
public/ChatExport_2026-06-15/
public/_tmpframes/
.thumbs/
