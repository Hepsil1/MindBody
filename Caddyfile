{
    # Global options
    email your_email@example.com
}

saleid.icu {
    reverse_proxy localhost:3000

    # Gzip + Zstandard compression
    encode zstd gzip

    # Aggressive cache for static assets (images, fonts, JS, CSS)
    @static {
        path *.webp *.png *.jpg *.jpeg *.gif *.ico *.svg
        path *.woff *.woff2 *.ttf *.otf
        path *.js *.css *.map
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # HTML — short cache, allow revalidation
    @html {
        path /
        path *.html
    }
    header @html Cache-Control "public, max-age=60, stale-while-revalidate=300"

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Log requests
    log {
        output file c:\mindbody\caddy_access.log
        format json
    }
}
