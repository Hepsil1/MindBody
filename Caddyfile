{
	# Global options
	# Let's Encrypt контактный email — на него летят оповещения за 20/10 дней до
	# истечения сертификата, если автообновление сорвалось. Должен быть реальным.
	email i3331113@gmail.com

	# Batch 40 atom 4: enable HTTP/3 (QUIC) on all origin sites.
	# Cloudflare in front already advertises h3 via alt-svc, but if
	# a client bypasses the CDN (admin tooling, direct-IP probe) we
	# want them on the fast transport too.  QUIC 1-RTT handshake saves
	# 10-30 ms on lossy mobile.  `protocols` lives at the GLOBAL options
	# block in Caddyfile syntax; per-site placement is rejected.
	servers {
		protocols h1 h2 h3
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# Legacy origin — saleid.icu was the launch placeholder; the brand permanently
# moved to mindbody-sportwear.com on 2026-06-11. Everything on this hostname
# now 301-redirects to the canonical origin, preserving the path so external
# links (old Instagram posts, indexed Google results) land on the right page.
# 308 → permanent (cacheable by intermediaries, including Cloudflare in front).
#
# DNS for saleid.icu still resolves via Cloudflare to this VPS, so removing
# the upstream DNS records later (or letting the .icu domain expire) is the
# clean way to finally retire this block. Until then, keep this block to capture
# any traffic from old links — it's effectively free SEO equity transfer.
# ─────────────────────────────────────────────────────────────────────────────
saleid.icu, www.saleid.icu {
	redir https://mindbody-sportwear.com{uri} permanent

	# Even on a pure-redirect host we still want HSTS so browsers upgrade
	# subsequent direct visits to HTTPS without round-tripping through 301.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

	log {
		output file c:\mindbody\caddy_access.log
		format json
	}
}

# ─────────────────────────────────────────────────────────────────────────────
# Permanent domain. Both apex and www are listed so Let's Encrypt issues a
# single certificate covering both names. The www→apex redirect inside the
# block enforces a single canonical hostname for SEO (otherwise crawlers see
# two identical sites and split link equity).
#
# This origin sits DIRECTLY on the VPS — no Cloudflare in front (yet). Caddy
# obtains and renews the cert via HTTP-01 challenge on :80; no DNS-side work
# needed beyond the A records pointing at this server.
# ─────────────────────────────────────────────────────────────────────────────
mindbody-sportwear.com, www.mindbody-sportwear.com {
	# Canonical host: www → apex (301)
	@www host www.mindbody-sportwear.com
	redir @www https://mindbody-sportwear.com{uri} permanent

	reverse_proxy localhost:3000

	encode zstd gzip

	# Hashed Vite build assets live under /assets/*-[hash].js|css — a content
	# change always produces a new filename, so these are safe to freeze forever.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Everything else static is served from public/ at STABLE paths (logo, fonts,
	# /uploads/* product photos, manifest). These can be overwritten in place — an
	# admin re-uploading a product image to the same path, say — so they must
	# revalidate instead of being cached immutably for a year (otherwise browsers
	# and the Cloudflare edge serve the stale file with no conditional request).
	# `not path /assets/*` leaves the hashed build assets on the immutable rule.
	@revalidate {
		not path /assets/*
		path *.webp *.avif *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.otf *.js *.css *.map
	}
	header @revalidate Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	@html {
		path /
		path *.html
	}
	header @html Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()"
		X-Permitted-Cross-Domain-Policies "none"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	log {
		output file c:\mindbody\caddy_access.log
		format json
	}
}
