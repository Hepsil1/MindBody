generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Decimal
  comparePrice    Decimal?
  sku             String?     @unique
  stock           Int         @default(0)
  status          String      @default("draft")
  category        String?
  images          String?
  colors          String?
  sizes           String?
  inventory       String?
  shopPageSlug    String?
  // SEO fields — optional, fall back to name/description if empty
  slug            String?     @unique
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([status])
  @@index([shopPageSlug])
  @@index([category])
  @@index([createdAt])
  @@index([slug])
}

model Customer {
  id           String   @id @default(uuid())
  passwordHash String?  @unique
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   Int         @unique
  customerId    String
  status        String      @default("pending")
  paymentStatus String      @default("pending")
  total         Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  customer      Customer    @relation(fields: [customerId], references: [id])
  items         OrderItem[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal
  size      String?
  color     String?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Slide {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("triptych")
  page      String   @default("home")
  link      String?
  image1    String
  image1Pos String   @default("center center")
  image2    String?
  image2Pos String   @default("center center")
  image3    String?
  image3Pos String   @default("center center")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id         String   @id @default(uuid())
  title      String
  subtitle   String?
  image      String
  imagePos   String   @default("center center")
  link       String
  buttonText String   @default("Переглянути все")
  order      Int      @default(0)
  // Batch 41: mood metadata for theme-appropriate card styling.
  // Values: 'yoga' | 'sport' | 'dance' | 'casual' | 'kids' | null.
  // When null the card renders in the existing neutral style. When set,
  // app/utils/moods.ts provides a preset (tint overlay + Cormorant
  // weight + letter-spacing) so /shop/yoga reads visually distinct from
  // /shop/sport without changing brand language.
  moodType   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ShopPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  subtitle     String?
  prefixLabel  String?
  heroImage    String
  heroImagePos String   @default("50% 50% 1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FilterConfig {
  id        String   @id @default("global")
  config    String
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  authorName String
  rating     Int
  text       String
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

model ContactRequest {
  id        String   @id @default(uuid())
  contact   String
  createdAt DateTime @default(now())
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("percent")
  discountValue Float
  minOrder      Float     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  source       String? // 'footer', 'cookie-banner', 'checkout', 'popup'
  consent      Boolean  @default(true)
  unsubscribed Boolean  @default(false)
  unsubKey     String   @unique @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}
