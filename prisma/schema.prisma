generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String      @id @default(uuid())
  name            String
  description     String?
  price           Decimal
  comparePrice    Decimal?
  sku             String?     @unique
  stock           Int         @default(0)
  status          String      @default("draft")
  category        String?
  // Deeper taxonomy (see app/utils/taxonomy.ts). Nullable; written/read via
  // raw SQL until a clean `prisma generate` (PM2 holds the engine DLL),
  // same pattern as Category.moodType.
  fabric          String? // sport | cotton
  sleeve          String? // long | short | sleeveless | velo
  images          String?
  colors          String?
  // Per-colour gallery override: JSON {"black":["/uploads/a.webp",...],
  // "white":[...]}. When the buyer picks a colour on the PDP the gallery
  // switches to that colour's photos; colours without an entry fall back
  // to the shared `images` array, so partially-tagged products degrade
  // gracefully instead of going blank.
  colorImages     String?
  sizes           String?
  inventory       String?
  shopPageSlug    String?
  // SEO fields — optional, fall back to name/description if empty
  slug            String?     @unique
  metaTitle       String?
  metaDescription String?
  // i18n: JSON {"en":{"name":...,"description":...},"ru":{...}} — read/written
  // via raw SQL (the moodType pattern) until a clean `prisma generate`.
  translations    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  orderItems      OrderItem[]

  @@index([status])
  @@index([shopPageSlug])
  @@index([category])
  @@index([fabric])
  @@index([sleeve])
  @@index([createdAt])
  @@index([slug])
}

model Customer {
  id           String   @id @default(uuid())
  passwordHash String?  @unique
  firstName    String
  lastName     String
  email        String   @unique
  phone        String?
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       Int                  @unique
  customerId        String
  status            String               @default("pending")
  paymentStatus     String               @default("pending")
  total             Decimal
  // Promo snapshot — so a placed order always reflects the discount it was
  // created with, independent of later promo edits/deletes (audit + disputes).
  appliedPromoCode  String?
  discountAmount    Decimal?             @default(0)
  // Checkout idempotency: the client sends a stable key per checkout attempt;
  // a retry with the same key returns the existing order instead of creating a
  // duplicate. Nullable + @unique → many NULLs allowed (legacy/no-key orders).
  idempotencyKey    String?              @unique
  // Best-effort confirmation email outcome: "sent" | "failed" | null (not attempted).
  emailStatus       String?
  // Storefront language the order was placed from (uk | en | ru) — picks the
  // confirmation-email language. Raw-SQL written until a clean generate.
  locale            String               @default("uk")
  // Fulfillment fields collected at checkout — needed so the admin can ship the
  // order (Nova Poshta city + warehouse, delivery/payment method, customer
  // comment). Raw-SQL written/read until a clean generate (locale pattern).
  // Nullable for legacy orders placed before these columns existed.
  shippingCity      String?
  shippingWarehouse String?
  deliveryMethod    String?
  paymentMethod     String?
  comment           String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  customer          Customer             @relation(fields: [customerId], references: [id])
  items             OrderItem[]
  statusHistory     OrderStatusHistory[]

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
}

// Append-only audit of every stock change, so an inaccurate count can always be
// traced to an order, a cancellation, or a manual adjustment (who/when/why).
model InventoryMovement {
  id         String   @id @default(uuid())
  productId  String
  variantKey String? // "size/color" of the affected variant; null = aggregate-only
  delta      Int // signed change applied to stock
  before     Int
  after      Int
  reason     String // order_created | order_cancelled | manual_adjustment | correction
  actor      String   @default("system")
  orderId    String?
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([orderId])
}

// Audit trail of order status / payment-status transitions.
model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  field     String   @default("status") // "status" | "paymentStatus"
  fromValue String?
  toValue   String
  actor     String   @default("admin")
  note      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal
  size      String?
  color     String?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Slide {
  id        String   @id @default(uuid())
  name      String
  type      String   @default("triptych")
  page      String   @default("home")
  link      String?
  image1    String
  image1Pos String   @default("center center")
  image2    String?
  image2Pos String   @default("center center")
  image3    String?
  image3Pos String   @default("center center")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           String   @id @default(uuid())
  title        String
  subtitle     String?
  image        String
  imagePos     String   @default("center center")
  link         String
  buttonText   String   @default("Переглянути все")
  order        Int      @default(0)
  // Batch 41: mood metadata for theme-appropriate card styling.
  // Values: 'yoga' | 'sport' | 'dance' | 'casual' | 'kids' | null.
  // When null the card renders in the existing neutral style. When set,
  // app/utils/moods.ts provides a preset (tint overlay + Cormorant
  // weight + letter-spacing) so /shop/yoga reads visually distinct from
  // /shop/sport without changing brand language.
  moodType     String?
  // i18n JSON {"en":{"title":...,"subtitle":...,"buttonText":...},"ru":{...}}
  translations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ShopPage {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  subtitle     String?
  prefixLabel  String?
  heroImage    String
  heroImagePos String   @default("50% 50% 1")
  // i18n JSON {"en":{"title":...,"subtitle":...,"prefixLabel":...},"ru":{...}}
  translations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model FilterConfig {
  id        String   @id @default("global")
  config    String
  updatedAt DateTime @updatedAt
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  authorName String
  rating     Int
  text       String
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([isApproved])
}

model ContactRequest {
  id        String   @id @default(uuid())
  contact   String
  createdAt DateTime @default(now())
}

model PromoCode {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("percent")
  discountValue Float
  minOrder      Float     @default(0)
  maxUses       Int?
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
}

model NewsletterSubscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  source       String? // 'footer', 'cookie-banner', 'checkout', 'popup'
  consent      Boolean  @default(true)
  unsubscribed Boolean  @default(false)
  unsubKey     String   @unique @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

// Generic key-value store for owner-editable site content (contacts, home
// texts, mega-menu featured images...). `value` is a JSON blob validated
// per-key by Zod before write (app/utils/site-settings.ts). Read/written via
// raw SQL (the moodType pattern) so the feature works even while the
// generated client on prod predates this model.
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
