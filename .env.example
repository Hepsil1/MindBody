# MindBody Environment Variables (VPS / Self-Hosted)
# Copy this file to .env and fill in the values. Do NOT commit .env.

# ─── Database ─────────────────────────────────────────────────────
# Local PostgreSQL on VPS — no SSL needed
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mindbody_db?schema=public"

# ─── Session Security (REQUIRED) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# ─── Site URL (REQUIRED) ──────────────────────────────────────────
# Used for sitemap, Open Graph tags, cookie security, email links.
# MUST be the canonical production domain. No trailing slash.
SITE_URL="https://mindbody.com.ua"

# ─── Admin Panel ──────────────────────────────────────────────────
# Replace with a strong password in production (will be migrated to multi-admin table in Phase 5).
ADMIN_PASSWORD="change_me_in_production"

# ─── Telegram Notifications (order/registration alerts) ───────────
# Bot: https://t.me/BotFather → /newbot → copy token
# Chat ID: send a message to the bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Nova Poshta (delivery) ───────────────────────────────────────
# Required for checkout city/warehouse autocomplete.
# Get your key: https://my.novaposhta.ua/ → Settings → Security → API Keys
NOVA_POSHTA_API_KEY=""

# ─── Google OAuth ─────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI MUST match exactly what's registered with Google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://mindbody.com.ua/api/auth/google/callback"

# ─── Email (Resend) ───────────────────────────────────────────────
# Dashboard: https://resend.com/api-keys
# EMAIL_FROM domain must be verified in Resend (DKIM/SPF configured).
RESEND_API_KEY=""
EMAIL_FROM="hello@mindbody.com.ua"
EMAIL_FROM_NAME="MIND BODY"
EMAIL_REPLY_TO="hello@mindbody.com.ua"

# ─── Supabase (legacy, kept for migration window) ─────────────────
# Set to empty strings if not used. Will be removed in Phase 5.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ─── Optional: Node environment ───────────────────────────────────
# Auto-set by build/runtime in most cases. Override only if needed.
# NODE_ENV="production"
