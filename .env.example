# MindBody Environment Variables (VPS / Self-Hosted)
# Copy this file to .env and fill in the values

# Database (local PostgreSQL on VPS — no SSL needed)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mindbody_db?schema=public"

# Session Security (REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
SESSION_SECRET=""

# Supabase (Auth & Database)
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your_anon_key_here"

# Admin Panel
ADMIN_PASSWORD="change_me_in_production"

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Nova Poshta API (required for checkout city/warehouse search)
# Get your key: https://my.novaposhta.ua/ → Settings → Security → API Keys
NOVA_POSHTA_API_KEY=""

# Site URL (used for sitemap, OG tags, cookie security)
# Set to https:// only when SSL certificate is configured
SITE_URL="https://yourdomain.com"
