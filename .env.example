# MindBody Environment Variables (VPS / Self-Hosted)
# Copy this file to .env and fill in the values. Do NOT commit .env.

# ─── Database ─────────────────────────────────────────────────────
# Local PostgreSQL on VPS — no SSL needed
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/mindbody_db?schema=public"

# ─── Session Security (REQUIRED) ──────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# ─── Site URL (REQUIRED) ──────────────────────────────────────────
# Used for sitemap, Open Graph tags, cookie security, email links.
# MUST match the live HTTPS domain Caddy is currently serving.
# No trailing slash.
SITE_URL="https://mindbody-sportwear.com"

# ─── Admin Panel ──────────────────────────────────────────────────
# Login form gates on username + password. ADMIN_USERNAME defaults to
# "Admin" if unset. Replace both with strong values in production
# (will be migrated to a multi-admin table in Phase 5).
ADMIN_USERNAME="Admin"
# Prefer a bcrypt hash: `node scripts/hash-admin-password.mjs "<password>"`,
# then set ADMIN_PASSWORD_HASH and remove ADMIN_PASSWORD. One of the two must be
# set; verifyAdminPassword() uses the hash when present.
ADMIN_PASSWORD="change_me_in_production"
# ADMIN_PASSWORD_HASH=""

# ─── Telegram Notifications (order/registration alerts) ───────────
# Bot: https://t.me/BotFather → /newbot → copy token
# Chat ID: send a message to the bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Nova Poshta (delivery) ───────────────────────────────────────
# Required for checkout city/warehouse autocomplete.
# Get your key: https://my.novaposhta.ua/ → Settings → Security → API Keys
NOVA_POSHTA_API_KEY=""

# ─── Google OAuth ─────────────────────────────────────────────────
# Console: https://console.cloud.google.com/apis/credentials
# Redirect URI MUST match exactly what's registered with Google AND
# the current SITE_URL.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://mindbody-sportwear.com/api/auth/google/callback"

# ─── Email (Resend) ───────────────────────────────────────────────
# Dashboard: https://resend.com/api-keys
# EMAIL_FROM domain must be verified in Resend (DKIM/SPF configured).
RESEND_API_KEY=""
EMAIL_FROM="hello@mindbody-sportwear.com"
EMAIL_FROM_NAME="MIND BODY"
EMAIL_REPLY_TO="hello@mindbody-sportwear.com"

# ─── Analytics (GA4 + Meta Pixel) ─────────────────────────────────
# Both are optional. Empty → the loader skips the injection and the site
# stays beacon-free. Both run ONLY after the cookie banner is accepted.
# Vite inlines these at build time, so changing them requires `npm run
# build` + `pm2 delete mindbody && pm2 start ...` (PM2 on Windows does
# NOT re-read .env on plain restart — see migration runbook).
VITE_GA4_ID=""
VITE_META_PIXEL_ID=""

# ─── Supabase (legacy, kept for migration window) ─────────────────
# Set to empty strings if not used. Will be removed in Phase 5.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ─── Optional: Node environment ───────────────────────────────────
# Auto-set by build/runtime in most cases. Override only if needed.
# NODE_ENV="production"

# ─── Instagram scrape (homepage iPhone mock) ──────────────────────
# All optional — blank/disabled = the curated hardcoded fallback. See
# docs/instagram-scrape.md. Server-only (never in the client bundle).
# NOTE: this VPS IP is 429-blocked by Instagram → a residential/mobile
# IG_SCRAPE_PROXY is REQUIRED for a real fetch to succeed.
IG_SCRAPE_ENABLED="false"
IG_SCRAPE_TARGET="mindbody_sportwear"
IG_SCRAPE_SESSIONID=""
IG_SCRAPE_PROXY=""
IG_REFRESH_TOKEN=""
